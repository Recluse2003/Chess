@page "{gameId:guid}"
@model IndexModel

@{
    ViewData["Title"] = "Chess Game";
}

@Html.AntiForgeryToken()

<head>
    <link rel="stylesheet" href="~/css/chess.css" asp-append-version="true" />
</head>

<h1>Chess Game</h1>

<p><strong>Game ID:</strong> @Model.Game!.GameId</p>

<p>
    <strong>Status:</strong>
    @Model.Game.Status
</p>

<p>
    <strong>Turn:</strong>
    @Model.Game.CurrentTurn
</p>

<p>
    <strong>White:</strong>
    @Model.Game.WhitePlayerId
</p>

<p>
    <strong>Black:</strong>
    @(Model.Game.BlackPlayerId ?? "Waiting for opponent")
</p>

<div class="chess-board"
     data-game-id="@Model.Game.GameId"
     data-status="@Model.Game.Status"
     data-current-turn="@Model.Game.CurrentTurn"
     data-is-white-player="@Model.Game.IsWhitePlayer">

    @if (Model.Game.IsWhitePlayer)
    {
        for (int rank = 7; rank >= 0; rank--)
        {
            for (int file = 0; file < 8; file++)
            {
                <div class="chess-square @((file + rank) % 2 == 1 ? "light-square" : "dark-square")"
                    data-file="@file"
                    data-rank="@rank">
                    @{
                        var piece = Model.Game.Pieces.FirstOrDefault(p => p.File == file && p.Rank == rank);
                    }
                    
                    @if (piece != null)
                    {
                        <span class="chess-piece" data-piece="@piece.Piece">
                            @Model.GetPieceSymbol(piece.Piece)
                        </span>
                    }
                </div>

            }
        }
    }
    else
    {
        for (int rank = 0; rank < 8; rank++)
        {
            for (int file = 7; file >= 0; file--)
            {
                <div class="chess-square @((file + rank) % 2 == 0 ? "light-square" : "dark-square")"
                     data-file="@file"
                     data-rank="@rank">
                    @{
                        var piece = Model.Game.Pieces.FirstOrDefault(p => p.File == file && p.Rank == rank);
                    }

                    @if (piece != null)
                    {
                        <span class="chess-piece" data-piece="@piece.Piece">
                            @Model.GetPieceSymbol(piece.Piece)
                        </span>
                    }
                </div>

            }
        }
    }
</div>

<div id="promotion-modal" class="promotion-modal-overlay hidden">
    <div class="promotion-options">
        <button data-piece="Q">♕</button>
        <button data-piece="R">♖</button>
        <button data-piece="B">♗</button>
        <button data-piece="N">♘</button>
    </div>
</div>


<div id="game-end-modal" class="game-end-modal-overlay hidden">
    <div class="game-end-modal-box">
        <button id="closeBtn" class="game-end-modal-close">×</button>

        <h3 id="game-end-title"></h3>
        <p id="game-end-message"></p>
    </div>
</div>

<script src="~/js/chess.js" asp-append-version="true"></script>